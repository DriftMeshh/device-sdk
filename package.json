{
  "name": "@driftmeshh/device-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Client library + reading simulator for DriftMesh sensors. Signs and submits readings to the deployed Soroban contracts.",
  "type": "module",
  "workspaces": [
    "bindings/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && tsc -p tsconfig.json",
    "simulate": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1",
    "device-registry": "*",
    "submission-validator": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
