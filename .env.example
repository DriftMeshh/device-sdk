# Optional. The device's own Stellar keypair — it signs its own
# registration and every reading it submits. Generate with `stellar keys
# generate <name> --network testnet --fund` and get the secret with
# `stellar keys secret <name>`. Leave unset and index.ts auto-provisions
# one on first run: generates a keypair, funds it via testnet Friendbot,
# and persists it to ./data/device-identity.json so later restarts reuse
# the same device instead of registering a new one each time — see
# src/identity.ts. Only ever auto-funds against testnet.
DEVICE_SECRET=

# Optional. The device owner's public key (can deactivate the device
# later). Leave unset and the device owns itself.
OWNER_PUBLIC_KEY=

DEVICE_TYPE=weather
LAT=40.7128
LON=-73.9690

STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract IDs from the contracts repo's `stellar contract deploy` (or see
# contracts/TESTNET.md for the already-deployed testnet IDs).
DEVICE_REGISTRY_CONTRACT_ID=
SUBMISSION_VALIDATOR_CONTRACT_ID=

# Must match whatever other devices/the indexer use for the same physical
# area — see src/region.ts.
REGION_CELL_SIZE_DEGREES=0.1

# Reward-epoch window, in seconds. Devices and payment-streamer need to
# agree on this (it's a shared convention, not read from the contract).
EPOCH_SECONDS=3600

SUBMIT_INTERVAL_MS=60000
