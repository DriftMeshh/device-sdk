# Optional. The device's own Stellar keypair — it signs its own
# registration and every reading it submits. Generate with `stellar keys
# generate <name> --network testnet --fund` and get the secret with
# `stellar keys secret <name>`. Leave unset and index.ts auto-provisions
# one on first run: generates a keypair, funds it via testnet Friendbot,
# and persists it to ./data/device-identity.json so later restarts reuse
# the same device instead of registering a new one each time — see
# src/identity.ts. Only ever auto-funds against testnet.
DEVICE_SECRET=

# Optional. The device owner's public key (can deactivate the device
# later). Leave unset and the device owns itself.
OWNER_PUBLIC_KEY=

DEVICE_TYPE=weather
LAT=40.7128
LON=-73.9690

STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract IDs from the contracts repo's `stellar contract deploy` (or see
# contracts/TESTNET.md for the already-deployed testnet IDs).
DEVICE_REGISTRY_CONTRACT_ID=
SUBMISSION_VALIDATOR_CONTRACT_ID=

# Optional — only needed to use the `claim` CLI command
# (`node dist/index.js claim [--epoch <n>]`).
PAYMENT_STREAMER_CONTRACT_ID=

# Must match whatever other devices/the indexer use for the same physical
# area — see src/region.ts.
REGION_CELL_SIZE_DEGREES=0.1

# Reward-epoch window, in seconds. Devices and payment-streamer need to
# agree on this (it's a shared convention, not read from the contract).
EPOCH_SECONDS=3600

SUBMIT_INTERVAL_MS=60000

# Optional. Horizon endpoint used only for the trustline check below.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional — both unset (the default) disables the startup trustline
# check entirely. Set both to have device-sdk automatically establish a
# classic-Stellar trustline to the reward asset on startup if the device's
# account doesn't already have one — needed before payment-streamer's
# claim() can pay this device out. See contracts/TESTNET.md for the
# already-deployed testnet DMU asset's code/issuer.
REWARD_ASSET_CODE=
REWARD_ASSET_ISSUER=

# Optional. "text" (default) logs human-readable "[device-sdk] event
# field=value" lines; "json" logs one-line JSON objects instead — useful
# for ingestion by a monitoring tool or when running many device-sdk
# instances at once.
LOG_FORMAT=text

# Optional. How many consecutive rejected readings trigger a distinct
# "sensor may be miscalibrated" warning (fires once per streak, resets on
# any accepted reading). 3 rules out a single borderline reading near the
# tolerance boundary while still catching a real miscalibration quickly.
REJECTION_WARNING_THRESHOLD=3

# Optional. Sensor driver: "simulate" (default) or "bme280".
# Set to "bme280" to read a real Bosch BME280 temperature sensor over I²C
# (e.g. on a Raspberry Pi). See src/hardware/bme280.ts for full wiring and
# kernel module setup instructions. Leave unset (or set to "simulate") to
# use the built-in random-walk simulator — no hardware required.
SENSOR_DRIVER=simulate

# Optional. Only used when SENSOR_DRIVER=bme280.
# I2C_BUS_NUMBER: I²C bus number on the host — 1 on all modern Raspberry
# Pi models (default 1).
# I2C_ADDRESS: I²C device address in hex — 0x76 when SDO is pulled low
# (the common default), 0x77 when SDO is pulled high (default 0x76).
# I2C_BUS_NUMBER=1
# I2C_ADDRESS=0x76
